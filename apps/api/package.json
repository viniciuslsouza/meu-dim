{
  "name": "@meudim/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && jest --config jest-unit.config.js --runInBand",
    "test:unit": "jest --config jest-unit.config.js --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "lint": "eslint src test --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@meudim/shared": "workspace:*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^10.74.0",
    "bullmq": "^5.81.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.4.1",
    "passport": "~0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.27.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@meudim/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "10.4.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
