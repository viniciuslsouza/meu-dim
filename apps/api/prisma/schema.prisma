datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  FREE
  ONE_TIME
  SUBSCRIBER
}

enum DebtType {
  CREDIT_CARD
  LOAN
  OVERDRAFT
  OTHER
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  plan          PlanTier           @default(FREE)
  planExpiresAt DateTime?
  statements    Statement[]
  debts         Debt[]
  payoffPlans   PayoffPlan[]
  payments      Payment[]
  magicLinks    MagicLink[]
  categoryRules UserCategoryRule[]
}

model MagicLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Statement {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank           String
  referenceMonth String
  total          Decimal       @db.Decimal(12, 2)
  minimumPayment Decimal?      @db.Decimal(12, 2)
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@unique([userId, bank, referenceMonth])
}

model Transaction {
  id           String    @id @default(cuid())
  statementId  String
  statement    Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date         DateTime
  description  String
  merchantKey  String
  amount       Decimal   @db.Decimal(12, 2)
  category     String
  installment  Int?
  installments Int?
  isRecurring  Boolean   @default(false)
}

model UserCategoryRule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  category    String
  createdAt   DateTime @default(now())

  @@unique([userId, merchantKey])
}

model Debt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           DebtType
  balance        Decimal  @db.Decimal(12, 2)
  monthlyRate    Decimal  @db.Decimal(6, 4)
  minimumPayment Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PayoffPlan {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy      String
  monthlyBudget Decimal  @db.Decimal(12, 2)
  resultJson    Json
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

model Payment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  externalId String    @unique
  amount     Decimal   @db.Decimal(12, 2)
  status     String    @default("PENDING")
  product    String
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
}
